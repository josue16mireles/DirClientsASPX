<%@ Page Title="" Language="C#" MasterPageFile="~/Root.master" AutoEventWireup="true" CodeBehind="PolizasExport.aspx.cs" Inherits="dir_clients.PolizasExport" %>
<%@ Register Assembly="DevExpress.Web.v22.2, Version=22.2.3.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" Namespace="DevExpress.Data.Linq" TagPrefix="dx" %>

<asp:Content ID="Content1" ContentPlaceHolderID="PageContent" runat="server">
    <dx:EntityServerModeDataSource ID="dsPolizasExport" runat="server" OnSelecting="dsPolizasExport_Selecting" ContextTypeName="ClientsDataModel" TableName="vpoliza" />
    
    <%--<dx:ASPxGridViewExporter ID="gridExporter" runat="server" GridViewID="gridView"/>--%>
     <dx:ASPxGridView ID="gridView" runat="server" KeyFieldName="uid_poliza" DataSourceID="dsPolizasExport" SettingsExport-FileName="filetest">
        
         <Columns>
             <dx:GridViewCommandColumn ShowSelectCheckbox="True" SelectAllCheckboxMode="AllPages" VisibleIndex="13" FixedStyle="Left" Width="52"></dx:GridViewCommandColumn>
             <dx:GridViewDataTextColumn FieldName="uid_poliza" ReadOnly="True" Visible="False" VisibleIndex="0">
             </dx:GridViewDataTextColumn>
             <dx:GridViewDataTextColumn Caption="Nombre" FieldName="nombre" ShowInCustomizationForm="True" VisibleIndex="2" Width="350px">
             </dx:GridViewDataTextColumn>
             <dx:GridViewDataTextColumn FieldName="uid_client" ReadOnly="True" Visible="False" VisibleIndex="1">
             </dx:GridViewDataTextColumn>
             <dx:GridViewDataTextColumn Caption="Poliza" FieldName="no_poliza" VisibleIndex="3" ShowInCustomizationForm="true" Width="150">
             </dx:GridViewDataTextColumn>
             <dx:GridViewDataDateColumn Caption="Fech. Ini." FieldName="fech_inicio" Visible="False" VisibleIndex="4" ShowInCustomizationForm="true" Width="120">
             </dx:GridViewDataDateColumn>
             <dx:GridViewDataTextColumn Caption="Vencimiento" FieldName="fech_vencimiento" VisibleIndex="5" Visible="False" ReadOnly="true" ShowInCustomizationForm="true" Width="120">
                  <PropertiesTextEdit DisplayFormatString="d"></PropertiesTextEdit>
             </dx:GridViewDataTextColumn>
             <dx:GridViewDataComboBoxColumn Caption="Frec. Pago"  FieldName="tipo_pago" Visible="False" VisibleIndex="6" ShowInCustomizationForm="true" Width="150">
                 <PropertiesComboBox>
                     <Items>
                         <dx:ListEditItem Text="Mensual" Value="1" />
                         <dx:ListEditItem Text="Trimestral" Value="2" />
                         <dx:ListEditItem Text="Semestral" Value="3" />
                         <dx:ListEditItem Text="Anual" Value="4" />
                     </Items>
                 </PropertiesComboBox>
             </dx:GridViewDataComboBoxColumn>
             <dx:GridViewDataTextColumn Caption="Sig. Pago" FieldName="nxt_pago" VisibleIndex="7" ReadOnly="true" ShowInCustomizationForm="true" Width="120">
                  <PropertiesTextEdit DisplayFormatString="d"></PropertiesTextEdit>
             </dx:GridViewDataTextColumn>

             <dx:GridViewDataTextColumn Caption="Compañia" FieldName="company" ShowInCustomizationForm="true" VisibleIndex="8"  Width="200">
             </dx:GridViewDataTextColumn>
             <dx:GridViewDataTextColumn Caption="Producto" FieldName="Producto" VisibleIndex="9" ShowInCustomizationForm="true" Width="300">
             </dx:GridViewDataTextColumn>

             <dx:GridViewDataTextColumn Caption="Estatus" FieldName="estatus" Visible="False" CellStyle-HorizontalAlign="Center" ReadOnly="true" VisibleIndex="10" Width="90" >
                 <CellStyle HorizontalAlign="Center"></CellStyle>
             </dx:GridViewDataTextColumn>
    
         </Columns>
     </dx:ASPxGridView>
</asp:Content>
